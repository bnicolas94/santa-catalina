DATABASE_URL=postgresql://postgres:postgres@localhost:5432/santa_catalina?schema=crm
NEXTAUTH_SECRET=
ERP_BASE_URL=https://app.santacatalina.online
CRM_BASE_URL=https://atencion.santacatalina.online
CRM_MOCK_WHATSAPP=true

# Clave maestra usada para cifrar las credenciales de cada canal en `crm`.
WHATSAPP_CONFIG_ENCRYPTION_KEY=

# La API Key y el Webhook Signing Secret de YCloud se cargan cifrados desde
# /settings. No deben copiarse a este archivo ni registrarse en Git.

# Embedded Signup de Meta. El CRM no habilita el onboarding si falta alguna
# variable. META_APP_SECRET y META_WEBHOOK_VERIFY_TOKEN nunca llegan al navegador.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=
